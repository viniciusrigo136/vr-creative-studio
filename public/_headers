# Cache do navegador (Cloudflare Pages / Netlify).
# assets/ tem o nome com "hash" (muda a cada build), então pode ficar em cache para sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Imagens da pasta public/: cache de 1 ano.
# IMPORTANTE: ao TROCAR uma imagem existente, salve com um NOME NOVO
# (ex.: capa-v2.webp) e atualize o caminho em src/content.ts — senão quem já visitou
# continua vendo a antiga.
/portfolio/*
  Cache-Control: public, max-age=31536000, immutable
/brand/*
  Cache-Control: public, max-age=31536000, immutable
/clientes/*
  Cache-Control: public, max-age=31536000, immutable
